{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MDV", "identifier": "app.mdv.viewer",
  "build": { "beforeDevCommand": "npm run dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "MDV — Markdown Viewer", "width": 1120, "height": 800, "minWidth": 560, "minHeight": 420 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost https: data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true, "targets": "all", "shortDescription": "Markdown viewer", "category": "Productivity",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "fileAssociations": [{ "ext": ["md", "markdown", "mdown"], "name": "Markdown Document", "description": "Markdown document", "mimeType": "text/markdown", "role": "Viewer" }],
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
